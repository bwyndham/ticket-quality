# Copy to .env (gitignored). Variables already set in your shell win.
ANTHROPIC_API_KEY=            # the rubric judge, and real eval runs
# ANTHROPIC_WORKSPACE_ID=     # only if your key isn't workspace-scoped

LINEAR_API_KEY=               # Linear > Settings > Security & access > Personal API keys

JIRA_BASE_URL=                # https://yourcompany.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=               # https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_AC_FIELD=customfield_10035   # if acceptance criteria live in their own field

# TICKET_LINT_TRACKER=linear  # which tracker a bare key like ENG-123 means, if both are set
# TICKET_LINT_JUDGE_MODEL=claude-sonnet-5-5
